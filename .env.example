# Copy to .env (ignored by Git) and fill in what you need. Never commit real values.
# Full explanation: docs/map-api-decision.md

# --- Routing provider (public, safe to expose: it is only a name) ---------------
# auto          openrouteservice when a key-holding proxy exists, otherwise OSRM (FOSSGIS, keyless)
# ors           openrouteservice only (shows "not configured" if no proxy is available)
# osrm-fossgis  keyless academic fallback only (non-commercial, ≤ 1 request/second)
# none          routing switched off; stops are shown without a line
PUBLIC_ROUTING_PROVIDER=auto

# --- openrouteservice key, LOCAL DEVELOPMENT ONLY (secret) ----------------------
# Optional. Free Standard plan key from https://account.heigit.org/
# Used by the Vite dev proxy (/api/ors → https://api.heigit.org/openrouteservice)
# while running `npm run dev`. Read in Node only; never sent to the browser,
# never written to dist/. Do NOT prefix it with PUBLIC_.
ORS_API_KEY=

# --- Production proxy URL (public: it is a URL, not a secret) -------------------
# Optional. Root URL of the deployed serverless/route-proxy function, which holds
# the key as its own secret and forwards to https://api.heigit.org/openrouteservice.
# Example shape: https://<your-worker>.<your-account>.workers.dev
PUBLIC_ROUTE_PROXY_URL=
