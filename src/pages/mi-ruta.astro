---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import MapView from '@/components/map/MapView.astro';
// imported for its global .rbtn styles: suggestions render «Añadir a Mi Ruta» on the client
import RouteButton from '@/components/ui/RouteButton.astro';
import { REGIONS } from '@/data/regions';
import { weatherPoints } from '@/data/research';
import '@/styles/intel.css';
import { href, regionHref } from '@/i18n/routes';

void RouteButton;
const wx = weatherPoints.map((p) => ({ key: p.key, lat: p.lat, lon: p.lon }));
---
<BaseLayout title="Mi Ruta" description="Los lugares que guardaste en San Luis Potosí, en un recorrido por carretera con distancia, tiempo y orden sugerido. Se guardan solo en este navegador.">
  <PageHeader compact label="Mi Ruta" title="Tu viaje, a tu manera." lede="Los lugares que guardaste mientras explorabas, unidos por calles y carreteras reales. Elige desde dónde sales, cómo te mueves y en qué orden. Se guardan solo en este navegador; no necesitas cuenta." />

  <section class="section section--tight" data-ground="light" data-my-route data-places-url={href('placesData')} data-context-url={href('routeContextData')} data-intel-url={href('intelData')} data-wx={JSON.stringify(wx)} aria-label="Lugares guardados">
    <div class="wrap mr">
      <div class="mr__col">
        <div class="mr__summary" data-mr-summary hidden>
          <p class="mr__count"><span class="display" data-mr-count>0</span> lugares</p>
          <ul class="mr__regions" data-mr-regions aria-label="Regiones de tu ruta">
            {REGIONS.map((r) => <li data-region={r.id} data-mr-region={r.id}><span aria-hidden="true"></span>{r.name} <b data-mr-region-n>0</b></li>)}
          </ul>
        </div>
        <p class="mr__loading small muted" data-mr-loading>Cargando tu ruta…</p>

        <div class="plan" data-planner hidden>
          <fieldset class="plan__set">
            <legend class="label">Punto de partida</legend>
            <div class="plan__seg" data-origin-opts>
              <label><input type="radio" name="origin" value="gps" /><span>Mi ubicación</span></label>
              <label><input type="radio" name="origin" value="place" /><span>Un municipio</span></label>
              <label><input type="radio" name="origin" value="first" /><span>Mi primer lugar</span></label>
              <label><input type="radio" name="origin" value="point" /><span>Punto en el mapa</span></label>
            </div>
            <div class="plan__sub" data-origin-gps hidden>
              <div class="geo-card" data-plan-geo aria-live="polite"></div>
              <div class="geo-card__acts">
                <button type="button" class="geo-act" data-plan-locate>Usar mi ubicación</button>
                <button type="button" class="geo-act" data-plan-follow aria-pressed="false" hidden>Seguir mi posición</button>
              </div>
              <p class="geo-fine">Tu ubicación solo se usa en esta página para calcular la ruta. No se guarda ni se envía a estadísticas.</p>
            </div>
            <div class="plan__sub" data-origin-place hidden>
              <label class="plan__field"><span class="tiny muted">Cabecera municipal (INEGI)</span>
                <select data-origin-select><option value="">Elige un municipio…</option></select>
              </label>
            </div>
            <p class="plan__sub small" data-origin-point hidden>Usa «Elegir inicio en el mapa» y toca el punto desde donde sales.</p>
            <p class="plan__note small" data-origin-note hidden></p>
          </fieldset>

          <fieldset class="plan__set">
            <legend class="label">Cómo te mueves</legend>
            <div class="plan__seg" data-profile-opts>
              <label><input type="radio" name="profile" value="car" /><span>Auto</span></label>
              <label><input type="radio" name="profile" value="foot" /><span>A pie</span></label>
              <label><input type="radio" name="profile" value="bike" /><span>Bicicleta</span></label>
            </div>
          </fieldset>

          <div class="plan__sum" data-plan-summary aria-live="polite"></div>
          <div class="plan__opt" data-plan-opt hidden aria-live="polite"></div>
        </div>

        <ol class="mr__list" data-mr-list aria-label="Orden de tu recorrido"></ol>

        <div class="mr__empty" data-mr-empty hidden>
          <p class="display display--md">Tu ruta está vacía.</p>
          <p class="body muted">Explora el mapa, las regiones o los destinos y toca «Añadir a Mi Ruta» en los lugares que te llamen. Aparecerán aquí, en orden, con su región.</p>
          <div class="mr__empty-cta">
            <a class="btn" href={href('map')}>Explorar el mapa</a>
            <a class="btn btn--ghost" href={href('home', {}, 'es', 'que-hacer')}>Destinos imperdibles</a>
          </div>
        </div>

        <div class="mr__actions" data-mr-actions hidden>
          <button type="button" class="btn btn--ghost" data-mr-clear>Vaciar Mi Ruta</button>
          <a class="arrow" href={href('routes')}>Ver rutas sugeridas</a>
        </div>
        <div class="mr__suggest" data-mr-suggest hidden>
          <p class="label">Explora otra región</p>
          <p class="small muted">Tu ruta aún no pasa por:</p>
          <ul>{REGIONS.map((r) => <li data-region={r.id} data-mr-missing={r.id} hidden><a class="arrow" href={regionHref(r.slug)}>{r.name}</a></li>)}</ul>
        </div>
        <p class="mr__error small" data-mr-error hidden>No se pudieron cargar los datos de tus lugares. Revisa tu conexión y recarga la página; tu selección sigue guardada.</p>

        <section class="near" data-near hidden aria-labelledby="near-t">
          <h2 id="near-t" class="display display--sm">Cerca de tu recorrido</h2>
          <p class="small muted" data-near-lede aria-live="polite"></p>
          <ul class="rk-list" data-near-list></ul>
          <div class="near__acts">
            <button type="button" class="btn btn--ghost" data-near-measure hidden>Medir desvíos por carretera</button>
            <a class="arrow" href={href('discover')}>Ajustar mis intereses</a>
          </div>
          <p class="tiny muted" data-near-note aria-live="polite"></p>
        </section>

        <section class="alts" data-alts hidden aria-labelledby="alts-t">
          <h2 id="alts-t" class="display display--sm">Alternativas para descubrir</h2>
          <p class="small muted" data-alts-lede></p>
          <ul class="rk-list" data-alts-list></ul>
        </section>

        <section class="recos" data-recos hidden aria-labelledby="recos-t">
          <h2 id="recos-t" class="display display--sm">Para tu ruta</h2>
          <p class="small muted">Sugerencias con reglas simples sobre los datos del portal. Cada una dice por qué aparece; no reflejan afluencia ni disponibilidad en tiempo real.</p>
          <ul class="recos__list" data-recos-list></ul>
        </section>
      </div>
      <div class="mr__mapcol">
        <section class="nav" data-nav hidden aria-labelledby="nav-t">
          <h2 id="nav-t" class="visually-hidden">Recorrido en vivo</h2>

          <div class="nav__view" data-nav-view="idle">
            <p class="label">Recorrido en vivo</p>
            <p class="nav__lede" data-nav-idle-text>Sigue tu avance hacia cada lugar: distancia que falta, tiempo estimado y aviso al llegar.</p>
            <p class="nav__trip small" data-nav-trip hidden></p>
            <div class="nav__acts">
              <button type="button" class="btn" data-nav-start>Iniciar recorrido</button>
              <button type="button" class="btn btn--ghost" data-nav-reset hidden>Restablecer recorrido</button>
            </div>
            <p class="geo-fine">Al iniciar, el navegador te pedirá permiso para usar tu ubicación. Tu posición solo vive en esta página: no se guarda ni se envía a estadísticas. Es una guía para tu recorrido turístico, no un navegador certificado: no da indicaciones vuelta por vuelta. Con la pantalla apagada o la página en segundo plano, el navegador puede pausar tu ubicación.</p>
          </div>

          <div class="nav__view" data-nav-view="live" hidden>
            <p class="label">Siguiente destino</p>
            <p class="nav__dest" data-nav-dest>—</p>
            <p class="nav__big"><b data-nav-dist>—</b><b><span data-nav-time>—</span><span class="nav__aprox">aprox.</span></b></p>
            <p class="nav__eta small" data-nav-eta></p>
            <div class="nav__bar" role="progressbar" aria-label="Avance del recorrido" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-nav-bar><span></span></div>
            <p class="nav__count small" data-nav-count></p>
            <p class="geo-st" data-nav-status aria-live="polite"></p>
            <p class="geo-msg" data-nav-msg aria-live="polite" hidden></p>
            <div class="nav__acts">
              <button type="button" class="geo-act" data-nav-pause>Pausar</button>
              <button type="button" class="geo-act" data-nav-resume hidden>Reanudar</button>
              <button type="button" class="geo-act" data-nav-center hidden>Recentrar</button>
              <button type="button" class="geo-act" data-nav-reroute>Recalcular ruta</button>
              <button type="button" class="geo-act" data-nav-wake aria-pressed="false" hidden>Mantener pantalla encendida</button>
              <button type="button" class="geo-act" data-nav-stop>Terminar recorrido</button>
            </div>
            <details class="nav__more">
              <summary>Detalles de ubicación</summary>
              <dl class="geo-dl" data-nav-details></dl>
              <p class="geo-fine" data-nav-details-note></p>
            </details>
          </div>

          <div class="nav__view" data-nav-view="arrived" hidden>
            <p class="label">Llegada</p>
            <p class="nav__dest" data-nav-arrived-title>Has llegado</p>
            <p class="small" data-nav-arrived-note></p>
            <div class="nav__acts">
              <button type="button" class="btn" data-nav-visited>Marcar como visitado</button>
              <button type="button" class="btn btn--ghost" data-nav-continue>Continuar al siguiente lugar</button>
              <button type="button" class="geo-act" data-nav-stop>Terminar recorrido</button>
            </div>
          </div>

          <div class="nav__view" data-nav-view="finished" hidden>
            <p class="label">Recorrido terminado</p>
            <p class="nav__dest" data-nav-sum-title></p>
            <ul class="nav__sum small" data-nav-sum></ul>
            <p class="small" data-nav-sum-meta></p>
            <div class="nav__acts">
              <button type="button" class="btn btn--ghost" data-nav-reset>Restablecer recorrido</button>
              <button type="button" class="btn btn--ghost" data-nav-close>Volver a planear</button>
            </div>
          </div>

          <div class="nav__view" data-nav-view="error" hidden>
            <p class="geo-st" data-tone="err"><span class="geo-st__sym" aria-hidden="true">⊘</span>No pudimos iniciar el recorrido</p>
            <p class="geo-msg" data-nav-err></p>
            <div class="nav__acts">
              <button type="button" class="btn btn--ghost" data-nav-start>Reintentar</button>
              <button type="button" class="btn btn--ghost" data-nav-close>Volver a planear</button>
            </div>
          </div>

          <p class="geo-fine nav__fine">Tiempos estimados por el proveedor de rutas, sin tráfico en tiempo real. Si conduces, no manipules la pantalla: detente en un lugar seguro.</p>
        </section>
        <MapView mode="route" label="Mapa de tu ruta" height="min(72svh, 40rem)" />
        <p class="source">La línea sigue calles y carreteras calculadas por el servicio de rutas que se indica en la atribución. Si el cálculo falla, solo se muestran tus lugares: nunca dibujamos una línea recta como si fuera carretera. Distancias y tiempos son estimaciones del proveedor y no consideran tráfico en tiempo real. Lugares sin ubicación puntual no entran en el cálculo.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mr { display: grid; gap: var(--sc-7); }
  @media (min-width: 1000px) { .mr { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; } .mr__mapcol { position: sticky; top: calc(var(--slp-header-h) + 1rem); } }
  .mr__col { display: grid; gap: var(--sc-5); align-content: start; }
  .mr__mapcol { display: grid; gap: var(--sc-3); }
  .mr__count { display: flex; align-items: baseline; gap: 0.5rem; font-weight: 650; }
  .mr__count .display { font-size: 3rem; line-height: 1; }
  .mr__summary { display: grid; gap: var(--sc-3); }
  .mr__regions { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .mr__regions li { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.75rem; border: 1px solid var(--sc-hairline-strong); border-radius: 999px; font-size: 0.82rem; font-weight: 600; }
  .mr__regions li span { width: 8px; height: 8px; border-radius: 50%; background: var(--slp-region-ui); }
  .mr__regions li[data-zero] { opacity: 0.45; }
  .mr__list { list-style: none; display: grid; border-top: 1px solid var(--sc-hairline-strong); }
  .mr__list :global(li) { display: grid; grid-template-columns: auto 5rem 1fr auto; gap: var(--sc-3); align-items: center; padding: var(--sc-3) 0; border-bottom: 1px solid var(--sc-hairline); }
  .mr__list :global(.mr__n) { width: 1.8rem; height: 1.8rem; display: grid; place-items: center; border-radius: 50%; background: var(--slp-region-ui); color: #fff; font: 700 0.78rem/1 var(--sc-font-text); }
  .mr__list :global(.mr__img) { width: 5rem; aspect-ratio: 1; object-fit: cover; border-radius: var(--sc-r-sm); background: var(--sc-surface); }
  .mr__list :global(.mr__ph) { width: 5rem; aspect-ratio: 1; border-radius: var(--sc-r-sm); background: linear-gradient(160deg, #3a3630, #23211d); }
  .mr__list :global(.mr__name) { font: 600 1.35rem/1.1 var(--sc-font-display); }
  .mr__list :global(.mr__name a) { color: inherit; text-decoration: none; }
  .mr__list :global(.mr__meta) { font-size: 0.76rem; color: var(--sc-ink-soft); }
  .mr__list :global(.mr__ctrl) { display: flex; gap: 0.25rem; }
  .mr__list :global(.mr__ctrl button) { width: 40px; height: 40px; border: 1px solid var(--sc-hairline-strong); border-radius: var(--sc-r-sm); background: none; display: grid; place-items: center; font-size: 0.9rem; }
  .mr__list :global(.mr__ctrl button:disabled) { opacity: 0.3; cursor: default; }
  @media (max-width: 520px) {
    .mr__list :global(li) { grid-template-columns: auto 3.5rem 1fr; }
    .mr__list :global(.mr__img), .mr__list :global(.mr__ph) { width: 3.5rem; }
    .mr__list :global(.mr__ctrl) { grid-column: 2 / -1; }
  }
  .mr__empty { display: grid; gap: var(--sc-4); padding: var(--sc-6); border: 1px dashed var(--sc-hairline-strong); border-radius: var(--sc-r-sm); }
  .mr__empty-cta, .mr__actions { display: flex; flex-wrap: wrap; gap: var(--sc-3); align-items: center; }
  .mr__suggest ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--sc-5); }
  .mr__error { padding: var(--sc-3) var(--sc-4); background: var(--sc-surface); }
  .mr__list :global(.mr__leg) { grid-column: 3 / -1; font: 600 0.76rem/1.3 var(--sc-font-text); color: var(--sc-ink-soft); font-variant-numeric: tabular-nums; }
  .mr__list :global(.mr__leg b) { color: var(--sc-ink); }
  .mr__list :global(li.mr__start) { grid-template-columns: auto 1fr; }
  .mr__list :global(.mr__startmark) { width: 1.8rem; height: 1.8rem; border-radius: 50%; background: #fff; border: 6px solid var(--slp-charcoal); }
  .mr__list :global(.mr__tag) { display: inline-block; margin-right: 0.45rem; padding: 1px 6px; border-radius: 3px; background: var(--slp-charcoal); color: var(--slp-ivory); font: 700 0.6rem/1.4 var(--sc-font-text); letter-spacing: 0.1em; text-transform: uppercase; vertical-align: middle; }
  @media (max-width: 520px) { .mr__list :global(.mr__leg) { grid-column: 2 / -1; } }

  /* planner */
  .plan { display: grid; gap: var(--sc-5); padding: var(--sc-5); border: 1px solid var(--sc-hairline-strong); border-radius: var(--sc-r-sm); background: var(--slp-paper); min-width: 0; }
  .plan[hidden] { display: none; }
  .plan__set { border: 0; padding: 0; margin: 0; display: grid; gap: var(--sc-3); min-width: 0; }
  .plan__seg { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .plan__seg label { position: relative; }
  .plan__seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .plan__seg span {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 0.85rem; border: 1px solid var(--sc-hairline-strong); border-radius: var(--sc-r-sm);
    font: 700 0.7rem/1 var(--sc-font-text); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .plan__seg input:checked + span { background: var(--slp-charcoal); color: var(--slp-ivory); border-color: var(--slp-charcoal); }
  .plan__seg input:checked + span::before { content: '✓'; margin-right: 0.4rem; }
  .plan__seg input:focus-visible + span { outline: 2px solid var(--slp-charcoal); outline-offset: 2px; }
  .plan__sub { display: grid; gap: var(--sc-3); }
  .plan__sub[hidden], .plan__note[hidden], .plan__opt[hidden] { display: none; }
  .plan__field { display: grid; gap: 0.35rem; }
  .plan__field select { min-height: 44px; padding: 0 0.6rem; border: 1px solid var(--sc-hairline-strong); border-radius: var(--sc-r-sm); background: #fff; font: 600 0.9rem/1.2 var(--sc-font-text); color: var(--slp-charcoal); max-width: 100%; }
  .plan__note { padding: 0.5rem 0.7rem; background: var(--sc-surface); border-radius: var(--sc-r-sm); }
  .plan__sum { display: grid; gap: var(--sc-3); border-top: 1px solid var(--sc-hairline-strong); padding-top: var(--sc-4); }
  .plan__sum :global(.sum__big) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1.4rem; }
  .plan__sum :global(.sum__big b) { font: 600 clamp(2.1rem, 1.6rem + 1.6vw, 2.9rem)/1 var(--sc-font-display); font-variant-numeric: tabular-nums; }
  .plan__sum :global(.sum__big span) { font-size: 0.8rem; color: var(--sc-ink-soft); margin-left: 0.25rem; }
  .plan__sum :global(.sum__meta) { font-size: 0.84rem; line-height: 1.5; }
  .plan__sum :global(.sum__alts) { display: grid; gap: 0.3rem; border: 0; padding: 0; margin: 0; }
  .plan__sum :global(.sum__alts label) { display: flex; gap: 0.5rem; align-items: center; font-size: 0.84rem; min-height: 36px; }
  .plan__sum :global(.sum__fine), .plan__opt :global(.sum__fine) { font-size: 0.72rem; color: var(--sc-ink-soft); }
  .plan__opt { display: grid; gap: var(--sc-3); border-top: 1px solid var(--sc-hairline); padding-top: var(--sc-4); }
  .plan__opt :global(table) { width: 100%; border-collapse: collapse; font-size: 0.84rem; font-variant-numeric: tabular-nums; }
  .plan__opt :global(th), .plan__opt :global(td) { text-align: left; padding: 0.45rem 0.3rem; border-bottom: 1px solid var(--sc-hairline); }
  .plan__opt :global(th) { font: 700 0.62rem/1.2 var(--sc-font-text); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sc-ink-soft); }
  .plan__opt :global(ol) { padding-left: 1.3rem; font-size: 0.86rem; display: grid; gap: 0.15rem; }
  .plan__opt :global(.opt__acts) { display: flex; flex-wrap: wrap; gap: var(--sc-3); }

  .plan[data-locked] { opacity: 0.55; }
  /* mobile / tablet trip view: card and map move to the top of the page */
  @media (max-width: 999px) { .mr__mapcol[data-nav-live] { order: -1; } }
  /* desktop trip view: card + map share the viewport so the whole map stays reachable */
  @media (min-width: 1000px) {
    .mr__mapcol[data-nav-live] :global(.mapv__canvas) { height: max(18rem, calc(100svh - var(--slp-header-h) - var(--nav-h, 0px) - 4rem)); min-height: 18rem; }
  }

  /* live navigation card */
  .nav { display: grid; gap: var(--sc-4); padding: var(--sc-5); border: 1px solid var(--sc-hairline-strong); border-radius: var(--sc-r-sm); background: var(--slp-paper); min-width: 0; }
  .nav[hidden], .nav__view[hidden], .nav [hidden] { display: none; }
  .nav__view { display: grid; gap: var(--sc-3); min-width: 0; }
  .nav__lede { font-size: 0.92rem; line-height: 1.5; }
  .nav__trip { padding: 0.5rem 0.7rem; background: var(--sc-surface); border-radius: var(--sc-r-sm); }
  .nav__dest { font: 600 clamp(1.6rem, 1.3rem + 1vw, 2.1rem)/1.05 var(--sc-font-display); overflow-wrap: anywhere; }
  .nav__big { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1.4rem; }
  .nav__big b { font: 600 clamp(2rem, 1.6rem + 1.4vw, 2.7rem)/1 var(--sc-font-display); font-variant-numeric: tabular-nums; }
  .nav__aprox { font: 600 0.8rem/1 var(--sc-font-text); color: var(--sc-ink-soft); margin-left: 0.3rem; }
  .nav__eta { font-variant-numeric: tabular-nums; }
  .nav__bar { height: 6px; border-radius: 3px; background: var(--sc-hairline); overflow: hidden; }
  .nav__bar span { display: block; height: 100%; width: 0; background: var(--slp-charcoal); transition: width 0.4s ease; }
  @media (prefers-reduced-motion: reduce) { .nav__bar span { transition: none; } }
  .nav__count { color: var(--sc-ink-soft); font-variant-numeric: tabular-nums; }
  .nav__acts { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .nav__acts .geo-act { min-height: 40px; }
  .nav__more summary { cursor: pointer; font: 700 0.62rem/1.2 var(--sc-font-text); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sc-ink-soft); min-height: 32px; display: flex; align-items: center; }
  .nav__more[open] summary { margin-bottom: 0.4rem; }
  .nav__sum { padding-left: 1.2rem; display: grid; gap: 0.15rem; }
  .nav__fine { border-top: 1px solid var(--sc-hairline); padding-top: var(--sc-3); }
  .mr__list :global(.mr__done) { display: inline-block; margin-right: 0.45rem; padding: 1px 6px; border-radius: 3px; border: 1px solid var(--slp-charcoal); font: 700 0.6rem/1.4 var(--sc-font-text); letter-spacing: 0.1em; text-transform: uppercase; vertical-align: middle; }
  .mr__list :global(li[data-visited]) { opacity: 0.72; }

  /* route-aware suggestions and alternatives (cards: src/styles/intel.css) */
  .near, .alts { display: grid; gap: var(--sc-3); padding-top: var(--sc-5); border-top: 1px solid var(--sc-hairline-strong); min-width: 0; }
  .near[hidden], .alts[hidden] { display: none; }
  .near__acts { display: flex; flex-wrap: wrap; gap: var(--sc-4); align-items: center; }
  /* the scored corridor list replaces the planner's unscored «cerca de tu ruta» rows */
  [data-my-route][data-intel-corridor] .recos__list :global(li[data-kind='near-route']) { display: none; }

  /* recommendations */
