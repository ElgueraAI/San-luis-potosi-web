---
/** Global search over the static index (src/pages/data/search.json.ts). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { REGION_LABEL, counts } from '@/data/portal';
import { href } from '@/i18n/routes';
---
<BaseLayout title="Buscar" description="Busca municipios, destinos, experiencias, eventos, museos, arqueología y hospedaje en San Luis Potosí.">
  <PageHeader label="Buscar" title="¿Qué buscas?" tone="utility" ground="light" compact crumbs={[{ label: 'Buscar' }]} />
  <section class="psec psec--tight" data-ground="light" data-tone="utility" data-search data-search-src={href('directoryData', { name: 'search' })} aria-label="Búsqueda">
    <div class="wrap">
      <form class="dir__form sr__form" action={href('search')} method="get" role="search">
        <label class="sr__q">Buscar<input type="search" name="q" placeholder="Xilitla, cascadas, Xantolo, museo, hotel…" autocomplete="off" /></label>
        <label>Tipo
          <select name="tipo">
            <option value="">Todo</option>
            <option value="lugares">Lugares y municipios</option>
            <option value="experiencias">Experiencias</option>
            <option value="eventos">Eventos</option>
            <option value="cultura">Museos y recintos</option>
            <option value="hospedaje">Hospedaje</option>
            <option value="secciones">Temas y secciones</option>
          </select>
        </label>
        <label>Región<select name="region"><option value="">Todas</option>{Object.entries(REGION_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
        <noscript><button class="btn" type="submit">Buscar</button></noscript>
      </form>
      <p class="psec__count sr__status" aria-live="polite" data-search-status>Escribe un destino, municipio, evento o tema.</p>
      <ul class="sr__list" data-search-results></ul>
      <p class="truth sr__note">El índice incluye {counts.municipalities} municipios, destinos, experiencias, {counts.events} eventos, {counts.museums + counts.venues} museos y recintos, arqueología y {counts.lodging} hospedajes. Restaurantes y bares: en el <a href={href('food')}>directorio de gastronomía</a>.</p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .sr__form { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .sr__form { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); } }
  .sr__q input { font-size: 1.15rem; min-height: 3.2rem; }
  .sr__status { margin: var(--sc-5) 0 var(--sc-3); }
  .sr__list { list-style: none; display: grid; border-top: 1px solid var(--sc-hairline-strong); }
  .sres { border-bottom: 1px solid var(--sc-hairline); }
  .sres a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.15rem; padding: 0.85rem 0 0.85rem 1rem; color: inherit; text-decoration: none; box-shadow: inset 3px 0 0 var(--slp-region-ui, transparent); }
  @media (min-width: 760px) { .sres a { grid-template-columns: 12rem minmax(0, 1fr) auto; align-items: baseline; gap: 1rem; } }
  .sres a:hover .sres__n, .sres a:focus-visible .sres__n { text-decoration: underline; }
  .sres__k { font: 700 0.62rem/1.3 var(--sc-font-text); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sc-ink-soft); }
  .sres__n { font: 600 1.2rem/1.2 var(--sc-font-display); }
  .sres__m { font-size: 0.8rem; color: var(--sc-ink-soft); }
  .sr__note { margin-top: var(--sc-6); }
</style>
