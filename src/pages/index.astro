---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import Intro from '@/components/home/Intro.astro';
import Descent from '@/components/home/Descent.astro';
import { getRegions } from '@/lib/regions';

const locale = 'es';
const regions = await getRegions();
---
<BaseLayout locale={locale}>
  <HomeHero locale={locale} regions={regions} />
  <Intro locale={locale} regions={regions} />
  <Descent locale={locale} regions={regions} />
</BaseLayout>
