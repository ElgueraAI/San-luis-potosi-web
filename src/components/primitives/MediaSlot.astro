---
/**
 * One media slot. Renders the real, optimized image when the slot has a file,
 * otherwise a designed placeholder that states what belongs here. Components
 * never know which one they got, so real assets drop in without code changes.
 */
import { getImage } from 'astro:assets';
import { getSlot, resolveImage } from '@/lib/media';
import SlotLabel from './SlotLabel.astro';
import { pick, type Locale } from '@/i18n';

interface Props {
  id: string;
  locale?: Locale;
  label?: 'bl' | 'br' | 'tl' | 'tr' | 'none';
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { id, locale = 'es', label = 'bl', eager = false, sizes = '100vw', class: cls } = Astro.props;
const slot = await getSlot(id);

const alt = slot.decorative ? '' : pick(slot.alt, locale);
const position = `${(slot.focal.x * 100).toFixed(0)}% ${(slot.focal.y * 100).toFixed(0)}%`;

const desktop = slot.kind !== 'video' ? resolveImage(slot.src.desktop) : null;
const mobile = slot.kind !== 'video' ? resolveImage(slot.src.mobile ?? null) : null;

async function variants(src: NonNullable<typeof desktop>, widths: number[]) {
  const [avif, webp] = await Promise.all([
    getImage({ src, widths, format: 'avif' }),
    getImage({ src, widths, format: 'webp' }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: webp.src };
}
const d = desktop ? await variants(desktop, [960, 1600, 2400].filter((w) => w <= desktop.width)) : null;
const m = mobile ? await variants(mobile, [720, 1080, 1440].filter((w) => w <= mobile.width)) : null;
---
{d && desktop ? (
  <picture class:list={['slp-media', cls]}>
    {m && <source media="(max-width: 860px)" type="image/avif" srcset={m.avif} sizes={sizes} />}
    {m && <source media="(max-width: 860px)" type="image/webp" srcset={m.webp} sizes={sizes} />}
    <source type="image/avif" srcset={d.avif} sizes={sizes} />
    <img
      src={d.fallback}
      srcset={d.webp}
      sizes={sizes}
      width={desktop.width}
      height={desktop.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      style={`object-position:${position}`}
    />
  </picture>
) : (
  <figure
    class:list={['slp-media', 'slp-ph', cls]}
    data-region={slot.region}
    data-kind={slot.kind}
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
  >
    <span class="slp-ph__contours" aria-hidden="true"></span>
    {label !== 'none' && <SlotLabel id={slot.id} locale={locale} position={label} />}
  </figure>
)}

<style>
  .slp-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
  }
  .slp-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- placeholder ------------------------------------------------------ */
  .slp-ph {
    --ph-base: #2b2a26;
    --ph-deep: #1f1e1b;
    --ph-line: #8a7b66;
    --ph-ink: var(--slp-ivory);
    background:
      radial-gradient(120% 90% at var(--ph-light-x, 70%) var(--ph-light-y, 20%), color-mix(in oklab, var(--ph-base) 70%, var(--ph-line)) 0%, transparent 60%),
      linear-gradient(180deg, var(--ph-base), var(--ph-deep));
    color: var(--ph-ink);
  }
  .slp-ph[data-region='altiplano'] { --ph-base: #46352a; --ph-deep: #2a201a; --ph-line: #b66a32; --ph-light-x: 78%; --ph-light-y: 12%; }
  .slp-ph[data-region='centro']    { --ph-base: #e2cfc3; --ph-deep: #cdb3a6; --ph-line: #9e5f67; --ph-ink: var(--slp-charcoal); --ph-light-x: 30%; --ph-light-y: 10%; }
  .slp-ph[data-region='zona-media']{ --ph-base: #cfe4df; --ph-deep: #a9cfc8; --ph-line: #3d8f8a; --ph-ink: var(--slp-charcoal); --ph-light-x: 50%; --ph-light-y: 0%; }
  .slp-ph[data-region='huasteca']  { --ph-base: #1e4a3e; --ph-deep: #10291f; --ph-line: #68b9b0; --ph-light-x: 24%; --ph-light-y: 18%; }

  .slp-ph__contours {
    position: absolute;
    inset: -2%;
    background: var(--ph-line);
    opacity: 0.38;
    -webkit-mask: var(--slp-contours) center / 900px auto repeat;
    mask: var(--slp-contours) center / 900px auto repeat;
  }
  .slp-ph[data-kind='video'] .slp-ph__contours { -webkit-mask-size: 1300px auto; mask-size: 1300px auto; opacity: 0.3; }

</style>
