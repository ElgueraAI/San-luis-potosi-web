---
/**
 * Sticky section navigation for long pages (home, region pages). Docks under
 * the header and follows it up when the header hides. Active item follows the
 * section in view (src/scripts/subnav.ts). Phone: "Explorar ▾" + Mi Ruta.
 */
import { href } from '@/i18n/routes';

interface Props { items: { id: string; label: string }[]; title?: string; region?: string }
const { items, title = 'Explorar', region } = Astro.props;
---
<div class="subnav-sentinel" data-subnav-sentinel aria-hidden="true"></div>
<nav class="subnav" data-subnav aria-label="Secciones de esta página" data-region={region}>
  <div class="subnav__bar wrap">
    <button type="button" class="subnav__toggle" aria-expanded="false" aria-controls="subnav-list" data-subnav-toggle>
      <span data-subnav-current>{title}</span> <span class="subnav__caret" aria-hidden="true"></span>
    </button>
    <ul class="subnav__list" id="subnav-list" data-subnav-list>
      {items.map((it) => (
        <li><a href={`#${it.id}`} data-subnav-link={it.id}>{it.label}</a></li>
      ))}
    </ul>
    <a class="subnav__route" href={href('myRoute')}>Mi Ruta <span class="subnav__count" data-route-count>0</span></a>
  </div>
  <span class="subnav__progress" data-subnav-progress aria-hidden="true"></span>
</nav>

<style>
  .subnav-sentinel { height: 1px; margin-bottom: -1px; }
  .subnav {
    position: sticky;
    top: 0;
    z-index: 70;
    background: color-mix(in oklab, var(--slp-paper) 97%, transparent);
    color: var(--slp-charcoal);
    border-bottom: 1px solid var(--sc-hairline-strong);
    backdrop-filter: saturate(1.2) blur(10px);
    transition: transform 320ms var(--sc-ease-out);
  }
  /* Docked under a visible header; flush to the top when the header hides. */
  :global(html.subnav-docked:not(.hdr-hidden)) .subnav { transform: translateY(var(--slp-header-h)); }
  :global(html.subnav-docked) .subnav { box-shadow: 0 6px 18px -12px rgb(20 24 23 / 0.35); }
  .subnav__bar { height: var(--slp-subnav-h); display: flex; align-items: center; justify-content: space-between; gap: var(--sc-4); }
  .subnav__list { list-style: none; display: flex; gap: clamp(0.5rem, 1.6vw, 1.75rem); overflow-x: auto; scrollbar-width: none; }
  .subnav__list a {
    position: relative; display: inline-flex; align-items: center; min-height: var(--slp-tap);
    font: 700 0.7rem/1 var(--sc-font-text); letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none;
    color: var(--sc-ink-soft); white-space: nowrap; transition: color 160ms var(--sc-ease-out);
  }
  .subnav__list a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 6px; height: 2px; background: var(--slp-region-ui, var(--slp-charcoal)); transform: scaleX(0); transform-origin: left; transition: transform 260ms var(--sc-ease-out); }
  .subnav__list a[aria-current='true'] { color: var(--slp-charcoal); }
  .subnav__list a[aria-current='true']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) { .subnav__list a:hover { color: var(--slp-charcoal); } }
  .subnav__route { display: inline-flex; align-items: center; gap: 0.5rem; min-height: var(--slp-tap); font: 700 0.7rem/1 var(--sc-font-text); letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .subnav__count { min-width: 1.3rem; height: 1.3rem; display: inline-grid; place-items: center; padding: 0 0.3rem; border: 1px solid currentColor; border-radius: 999px; font-size: 0.64rem; letter-spacing: 0; }
  .subnav__count[data-filled] { background: var(--slp-charcoal); color: var(--slp-paper); }
  .subnav__toggle { display: none; }
  .subnav__progress { position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--slp-region-ui, var(--slp-gold-deep)); transform-origin: left; transform: scaleX(var(--p, 0)); }

  @media (max-width: 900px) {
    .subnav__toggle {
      display: inline-flex; align-items: center; gap: 0.5rem; min-height: var(--slp-tap); padding: 0; border: 0; background: none;
      font: 700 0.72rem/1 var(--sc-font-text); letter-spacing: 0.15em; text-transform: uppercase; color: inherit;
    }
    .subnav__caret { width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 200ms var(--sc-ease-out); }
    [aria-expanded='true'] .subnav__caret { transform: translateY(1px) rotate(-135deg); }
    .subnav__list {
      position: absolute; top: 100%; left: 0; right: 0;
      display: grid; gap: 0; padding: 0.4rem var(--sc-gutter) 0.8rem;
      background: var(--slp-paper); border-bottom: 1px solid var(--sc-hairline-strong); box-shadow: var(--sc-e2);
      visibility: hidden; opacity: 0; transform: translateY(-6px);
      transition: opacity 180ms var(--sc-ease-out), transform 180ms var(--sc-ease-out), visibility 0s linear 180ms;
    }
    .subnav[data-open] .subnav__list { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .subnav__list a { width: 100%; font-size: 0.78rem; border-bottom: 1px solid var(--sc-hairline); }
    .subnav__list a::after { display: none; }
    .subnav__list a[aria-current='true'] { color: var(--slp-charcoal); font-weight: 800; }
  }
</style>
