---
/**
 * Home hero. Real de Catorce panorama (strongest approved asset; the layered
 * Altiplano dawn plates are still NEEDS_MANUAL_ASSET) with restrained depth:
 * the photograph, the shade and the measured terrain line move at different
 * rates (src/scripts/hero.ts). Static under reduced motion.
 */
import Photo from '@/components/media/Photo.astro';
import { href, regionHref } from '@/i18n/routes';
import { REGIONS } from '@/data/regions';
import { profileGeometry } from '@/lib/profile';
import { mediaRecord } from '@/lib/media';

const HERO = 'wc-69780780';
const rec = mediaRecord(HERO)!;
const g = profileGeometry(1600, 140, { tolerance: 10, ceil: 3100 });
---
<section class="hero" data-ground="dark" data-hero-depth aria-labelledby="hero-title">
  <div class="hero__media" data-depth="0.18">
    <Photo id={HERO} fill eager focal="50% 62%" mobileFocal="36% 62%" sizes="100vw" widths={[640, 960, 1280, 1600, 2000, 2560]} />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <svg class="hero__line" data-depth="0.32" viewBox="0 0 1600 140" preserveAspectRatio="none" aria-hidden="true">
    <path d={g.line} vector-effect="non-scaling-stroke" />
  </svg>

  <div class="hero__copy wrap" data-depth="-0.08">
    <p class="label hero__kicker">San Luis Potosí · México</p>
    <h1 id="hero-title" class="display hero__title">
      <span>Cuatro mundos.</span>
      <span><em>Un</em> San Luis Potosí.</span>
    </h1>
    <p class="hero__lede">Del desierto alto a la selva de la Huasteca: un solo estado que cambia de paisaje, de luz y de cultura cuatro veces.</p>
    <div class="hero__ctas">
      <a class="btn btn--light" href="#regiones">Explora San Luis Potosí</a>
      <a class="btn btn--outline-light" href={href('plan')}>Planea tu viaje</a>
    </div>
  </div>

  <div class="hero__foot wrap">
    <ul class="hero__regions" aria-label="Las cuatro regiones">
      {REGIONS.map((r) => (
        <li data-region={r.id}><a href={regionHref(r.slug)}><span class="hero__dot" aria-hidden="true"></span>{r.name}</a></li>
      ))}
    </ul>
    <p class="hero__caption tiny">
      Real de Catorce, Altiplano · Foto: {rec.author}, {rec.licence}
      <span class="hero__pending" title="home-01-hero: escena por capas al amanecer (Altiplano). Needs manual asset.">· Escena por capas pendiente</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    max-height: 70rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--slp-night);
  }
  .hero__media { position: absolute; inset: -6% 0 -6%; will-change: transform; }
  .hero__media :global(img) { transform: scale(1.04); }
  .hero__shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, rgb(15 18 17 / 0.62) 0%, rgb(15 18 17 / 0.28) 42%, rgb(15 18 17 / 0) 70%),
      linear-gradient(0deg, rgb(15 18 17 / 0.72) 0%, rgb(15 18 17 / 0) 38%);
  }
  .hero__line {
    position: absolute; left: 0; right: 0; bottom: 12%; z-index: 2;
    width: 100%; height: clamp(70px, 12vh, 130px);
    fill: none; stroke: rgb(246 241 231 / 0.55); stroke-width: 1.25px;
    pointer-events: none; will-change: transform;
  }
  .hero__copy {
    position: absolute; z-index: 3; left: 0; right: 0;
    bottom: clamp(9rem, 24vh, 15rem);
    display: grid; gap: var(--sc-4); justify-items: start;
  }
  .hero__kicker { color: rgb(246 241 231 / 0.86); }
  .hero__title {
    font-size: clamp(2.9rem, 1.2rem + 4.6vw, 6.4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    display: grid;
    white-space: nowrap;
    text-shadow: 0 2px 30px rgb(10 12 11 / 0.35);
  }
  .hero__title em { font-weight: 500; }
  .hero__lede { max-width: 34rem; font-size: var(--sc-t-lg); line-height: 1.5; color: rgb(246 241 231 / 0.92); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--sc-3); margin-top: var(--sc-2); }
  .hero__foot {
    position: absolute; z-index: 3; left: 0; right: 0; bottom: var(--sc-5);
    display: flex; justify-content: space-between; align-items: flex-end; gap: var(--sc-4);
  }
  .hero__regions { list-style: none; display: flex; gap: clamp(0.75rem, 2.5vw, 2.25rem); }
  .hero__regions a {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: var(--slp-tap);
    font: 700 0.72rem/1 var(--sc-font-text); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none;
  }
  .hero__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--slp-region-dark); }
  .hero__caption { color: rgb(246 241 231 / 0.78); text-align: right; max-width: 26rem; }
  .hero__pending { white-space: nowrap; }

  @media (max-width: 760px) {
    .hero { min-height: 34rem; }
    .hero__shade {
      background:
        linear-gradient(0deg, rgb(15 18 17 / 0.85) 0%, rgb(15 18 17 / 0.45) 45%, rgb(15 18 17 / 0.15) 75%),
        linear-gradient(180deg, rgb(15 18 17 / 0.35), transparent 30%);
    }
    .hero__copy { bottom: 7.2rem; }
    .hero__title { font-size: clamp(2.3rem, 10.6vw, 3.4rem); }
    .hero__lede { font-size: 1.02rem; }
    .hero__ctas { width: 100%; }
    .hero__ctas .btn { flex: 1 1 100%; }
    .hero__line { bottom: 5.4rem; height: 56px; }
    .hero__regions { display: none; }
    .hero__caption { text-align: left; font-size: 0.66rem; }
    .hero__pending { display: none; }
  }
  @media (max-width: 760px) and (max-height: 700px) {
    .hero__lede { display: none; }
  }
</style>
