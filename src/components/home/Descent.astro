---
/**
 * The Descent: the signature moment. A pinned Scroll Craft act (engine
 * unmodified) over the measured INEGI transect Real de Catorce → San Luis
 * Potosí → Rioverde → Ciudad Valles. As the visitor scrolls, a marker travels
 * the real line, the altitude readout falls, and the photograph above the land
 * cuts hard at each regional boundary. The land itself is the area under the
 * line, so the photograph reads as the sky over the terrain.
 *
 * Reduced motion / no engine: the same content as a static figure plus four
 * regional panels (src/scripts/descent.ts never pins it).
 */
import Photo from '@/components/media/Photo.astro';
import { REGIONS } from '@/data/regions';
import { profile, regionElevation } from '@/data/research';
import { profileGeometry, fmtM, fmtKm } from '@/lib/profile';
import { regionHref } from '@/i18n/routes';

const W = 1000, H = 300, CEIL = 3200;
const g = profileGeometry(W, H, { tolerance: 4, ceil: CEIL });

// Descent photographs: home-05-descent-* in the home asset manifest.
const PHOTOS: Record<string, string> = {
  altiplano: 'wc-42373253',
  centro: 'wc-50604767',
  'zona-media': 'wc-76389273',
  huasteca: 'wc-45072511',
};
const FOCAL: Record<string, string> = { altiplano: '50% 40%', centro: '50% 45%', 'zona-media': '50% 40%', huasteca: '50% 45%' };

// Anchor km: the transect sample closest to each anchor locality.
const anchors = profile.anchors.map((a) => {
  let best = profile.samples[0], bd = Infinity;
  for (const s of profile.samples) {
    const d = Math.hypot(s.lat - a.lat, s.lon - a.lon);
    if (d < bd) { bd = d; best = s; }
  }
  return { name: a.name, km: best.km, m: best.m };
});
const data = {
  length: profile.lengthKm,
  ceil: CEIL,
  samples: profile.samples.map((s) => [s.km, Math.round(s.m), s.region, s.near]),
  segments: profile.segments,
};
const segs = profile.segments.map((s) => ({ ...s, meta: REGIONS.find((r) => r.id === s.region)!, elev: regionElevation(s.region) }));
---
<section
  id="descenso"
  class="dsc"
  data-ground="dark"
  data-descent
  data-sc-act="pin"
  data-sc-span="4.2"
  data-span-mobile="3.4"
  aria-labelledby="descent-title"
>
  <div class="dsc__stage" data-sc-stage>
    <div class="dsc__photos">
      {segs.map((s, i) => (
        <div class:list={['dsc__photo', { 'is-active': i === 0 }]} data-dsc-photo={s.region}>
          <Photo id={PHOTOS[s.region]} fill sizes="100vw" focal={FOCAL[s.region]} widths={[640, 960, 1280, 1600, 2000, 2560]} />
        </div>
      ))}
    </div>
    <div class="dsc__shade" aria-hidden="true"></div>

    <header class="dsc__head wrap">
      <p class="label dsc__kicker">El descenso · {fmtKm(profile.lengthKm)} de sierra a río</p>
      <h2 id="descent-title" class="visually-hidden">El descenso: de {fmtM(profile.summary.max_m)} a {fmtM(profile.summary.min_m)} a través de las cuatro regiones</h2>
      <div class="dsc__copies">
        {segs.map((s, i) => (
          <div class:list={['dsc__copy', { 'is-active': i === 0 }]} data-dsc-copy={s.region} data-region={s.region}>
            <p class="dsc__region display">{s.meta.name}</p>
            <p class="dsc__identity">{s.meta.identity}</p>
            <p class="dsc__range tiny">{fmtM(s.elev.max)} a {fmtM(s.elev.min)} · km {Math.round(s.from)} a {Math.round(s.to)}</p>
            <a class="arrow dsc__link" href={regionHref(s.meta.slug)}>Explora {s.meta.nameIn}</a>
          </div>
        ))}
      </div>
    </header>

    <div class="dsc__chart">
      <svg class="dsc__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <clipPath id="dsc-done"><rect data-dsc-clip x="0" y="0" width="0" height={H} /></clipPath>
          <linearGradient id="dsc-land" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#161b1a" stop-opacity="0.78" />
            <stop offset="1" stop-color="#161b1a" stop-opacity="0.96" />
          </linearGradient>
        </defs>
        <path class="dsc__land" d={g.area} fill="url(#dsc-land)" />
        {segs.slice(1).map((s) => <line class="dsc__boundary" x1={g.X(s.from)} x2={g.X(s.from)} y1={H} y2={g.Y(3000)} vector-effect="non-scaling-stroke" />)}
        <path class="dsc__line" d={g.line} vector-effect="non-scaling-stroke" />
        <g clip-path="url(#dsc-done)">
          {segs.map((s) => <path class="dsc__seg" d={g.segment(s.region)} data-region={s.region} vector-effect="non-scaling-stroke" />)}
        </g>
      </svg>

      <ul class="dsc__regions" aria-hidden="true">
        {segs.map((s) => (
          <li data-region={s.region} data-dsc-label={s.region} style={`left:${(s.from / profile.lengthKm) * 100}%;width:${((s.to - s.from) / profile.lengthKm) * 100}%`}>{s.meta.name}</li>
        ))}
      </ul>
      <ul class="dsc__anchors" aria-hidden="true">
        {anchors.map((a) => (
          <li style={`left:${(a.km / profile.lengthKm) * 100}%;top:${(1 - a.m / CEIL) * 100}%`}><span>{a.name}</span></li>
        ))}
      </ul>

      <div class="dsc__marker" data-dsc-marker aria-hidden="true">
        <span class="dsc__dot"></span>
        <div class="dsc__readout">
          <p class="dsc__alt" data-dsc-alt>{fmtM(profile.samples[0].m)}</p>
          <p class="dsc__where" data-dsc-where>km 0 · {profile.samples[0].near}</p>
        </div>
      </div>
    </div>

    <p class="dsc__finale display" data-dsc-finale>Al final de la línea, el agua.</p>
    <p class="dsc__src source">Perfil de elevación: INEGI, Continuo de Elevaciones Mexicano 3.0 (90 m). {profile.caveat}</p>
  </div>

  <p class="visually-hidden">
    Perfil medido a lo largo de {fmtKm(profile.lengthKm)}: comienza en {fmtM(profile.summary.start_m)} en Real de Catorce, alcanza {fmtM(profile.summary.max_m)} en la Sierra de Catorce y termina en {fmtM(profile.summary.end_m)} en Ciudad Valles.
    {segs.map((s) => `${s.meta.name}: de ${fmtM(s.elev.max)} a ${fmtM(s.elev.min)}. `)}
  </p>
  <script type="application/json" data-dsc-data set:html={JSON.stringify(data)} />
</section>

<style>
  .dsc { position: relative; background: var(--slp-night); }
  .dsc__stage { height: 100svh; min-height: 34rem; overflow: hidden; isolation: isolate; }
  :global(.dsc:not(.sc-act--pinned)) .dsc__stage { position: relative; }
  .dsc__photos { position: absolute; inset: 0; }
  .dsc__photo { position: absolute; inset: 0; opacity: 0; transition: opacity 260ms var(--sc-ease-out); }
  .dsc__photo.is-active { opacity: 1; }
  .dsc__shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, rgb(14 18 17 / 0.72) 0%, rgb(14 18 17 / 0.25) 34%, rgb(14 18 17 / 0) 55%),
      linear-gradient(90deg, rgb(14 18 17 / 0.45) 0%, rgb(14 18 17 / 0) 50%);
  }
  .dsc__head { position: absolute; z-index: 3; left: 0; right: 0; top: calc(var(--slp-header-h) + var(--sc-5)); display: grid; gap: var(--sc-4); }
  .dsc__kicker { color: rgb(246 241 231 / 0.85); }
  .dsc__copies { display: grid; }
  .dsc__copy { grid-area: 1 / 1; display: grid; gap: 0.5rem; justify-items: start; max-width: 34rem; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 280ms var(--sc-ease-out), transform 280ms var(--sc-ease-out), visibility 0s linear 280ms; }
  .dsc__copy.is-active { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .dsc__region { font-size: clamp(3rem, 1.6rem + 5.2vw, 6.6rem); line-height: 0.92; letter-spacing: -0.02em; }
  .dsc__region::before { content: ''; display: block; width: 2.4rem; height: 2px; margin-bottom: 0.9rem; background: var(--slp-region-dark); }
  .dsc__identity { font: italic 500 clamp(1.2rem, 1rem + 0.8vw, 1.65rem)/1.3 var(--sc-font-display); max-width: 30ch; }
  .dsc__range { color: rgb(246 241 231 / 0.82); font-variant-numeric: tabular-nums; }

  .dsc__chart { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; height: 44%; }
  .dsc__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dsc__line { fill: none; stroke: rgb(246 241 231 / 0.5); stroke-width: 1.25px; }
  .dsc__seg { fill: none; stroke-width: 3px; stroke-linejoin: round; stroke: var(--slp-region-dark); }
  .dsc__boundary { stroke: rgb(246 241 231 / 0.22); stroke-width: 1px; stroke-dasharray: 3 4; }
  .dsc__regions { list-style: none; position: absolute; left: 0; right: 0; bottom: var(--sc-5); height: 1.2rem; }
  .dsc__regions li { position: absolute; padding-left: 0.6rem; font: 700 0.66rem/1 var(--sc-font-text); letter-spacing: 0.16em; text-transform: uppercase; color: rgb(246 241 231 / 0.55); white-space: nowrap; overflow: hidden; transition: color 200ms; }
  .dsc__regions li.is-active { color: var(--slp-region-dark); }
  .dsc__anchors { list-style: none; position: absolute; inset: 0; pointer-events: none; }
  .dsc__anchors li { position: absolute; width: 0; height: 0; }
  .dsc__anchors li::before { content: ''; position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%; background: rgb(246 241 231 / 0.8); }
  .dsc__anchors span { position: absolute; left: 0.5rem; top: 0.45rem; font: 600 0.68rem/1.2 var(--sc-font-text); color: rgb(246 241 231 / 0.78); white-space: nowrap; }
  .dsc__anchors li:last-child span { left: auto; right: 0.5rem; }

  .dsc__marker { position: absolute; left: 0; top: 0; width: 0; height: 0; z-index: 3; will-change: transform; }
  .dsc__dot { position: absolute; left: -8px; top: -8px; width: 16px; height: 16px; border-radius: 50%; background: var(--slp-ivory); box-shadow: 0 0 0 5px rgb(246 241 231 / 0.18), 0 2px 8px rgb(0 0 0 / 0.4); }
  .dsc__readout { position: absolute; left: 0.9rem; bottom: 0.9rem; display: grid; gap: 0.15rem; white-space: nowrap; width: max-content; text-shadow: 0 1px 12px rgb(10 12 11 / 0.6); }
  .dsc__marker.is-right .dsc__readout { left: auto; right: 0.9rem; text-align: right; }
  .dsc__alt { font: 600 clamp(2rem, 1.4rem + 2vw, 3.2rem)/1 var(--sc-font-display); font-variant-numeric: tabular-nums lining-nums; }
  .dsc__where { font: 600 0.74rem/1.3 var(--sc-font-text); color: rgb(246 241 231 / 0.85); }

  .dsc__finale {
    position: absolute; z-index: 4; right: var(--sc-gutter); top: 50%; transform: translateY(-50%);
    max-width: 12ch; text-align: right; font-size: clamp(2.2rem, 1.4rem + 3vw, 4.4rem); line-height: 1;
    opacity: 0; transition: opacity 400ms var(--sc-ease-out);
  }
  .dsc__finale.is-on { opacity: 1; }
  .dsc__src { position: absolute; z-index: 4; right: var(--sc-gutter); bottom: 0.5rem; max-width: 46rem; text-align: right; color: rgb(246 241 231 / 0.62); font-size: 0.64rem; }

  @media (max-width: 760px) {
    .dsc__chart { height: 40%; }
    .dsc__head { top: calc(var(--slp-header-h) + var(--sc-3)); }
    .dsc__identity { font-size: 1.15rem; }
    .dsc__anchors span { display: none; }
    .dsc__regions li { font-size: 0.56rem; letter-spacing: 0.1em; padding-left: 0.25rem; }
    .dsc__finale { top: 40%; left: var(--sc-gutter); right: auto; text-align: left; }
    .dsc__src { left: var(--sc-gutter); text-align: left; bottom: 0.25rem; font-size: 0.58rem; }
    .dsc__regions { bottom: var(--sc-6); }
  }

  /* ---- static composition (reduced motion, no engine) -------------------- */
  :global(.dsc[data-static]) .dsc__stage { height: auto; min-height: 0; padding: var(--sc-section) 0 var(--sc-7); overflow: visible; display: grid; gap: var(--sc-6); }
  :global(.dsc[data-static]) .dsc__photos { position: relative; inset: auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; width: var(--slp-wrap); margin-inline: auto; order: 2; }
  :global(.dsc[data-static]) .dsc__photo { position: relative; opacity: 1; aspect-ratio: 16 / 10; }
  :global(.dsc[data-static]) .dsc__shade, :global(.dsc[data-static]) .dsc__marker, :global(.dsc[data-static]) .dsc__finale { display: none; }
  :global(.dsc[data-static]) .dsc__head { position: relative; top: auto; order: 0; }
  :global(.dsc[data-static]) .dsc__copies { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--sc-6); }
  :global(.dsc[data-static]) .dsc__copy { grid-area: auto; opacity: 1; visibility: visible; transform: none; }
  :global(.dsc[data-static]) .dsc__region { font-size: var(--sc-t-2xl); }
  :global(.dsc[data-static]) .dsc__chart { position: relative; height: 16rem; width: var(--slp-wrap); margin-inline: auto; order: 1; }
  :global(.dsc[data-static]) .dsc__src { position: relative; right: auto; bottom: auto; width: var(--slp-wrap); margin-inline: auto; text-align: left; order: 3; }
</style>
