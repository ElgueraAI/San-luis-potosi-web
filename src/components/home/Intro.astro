---
/** Descubre: the central idea, one strong photograph, four verified figures. */
import Photo from '@/components/media/Photo.astro';
import { profile, destinations, verifiedMunicipalityTotal, sourceUrl } from '@/data/research';
import { fmtM } from '@/lib/profile';

const pm = destinations.filter((d) => d.puebloMagico).length;
const figures = [
  { value: '4', label: 'regiones turísticas' },
  { value: String(verifiedMunicipalityTotal), label: 'municipios verificados en el PDU-SLP' },
  { value: String(pm), label: 'Pueblos Mágicos' },
  { value: `${fmtM(profile.summary.max_m)} → ${fmtM(profile.summary.min_m)}`, label: 'de desnivel a lo largo del transecto INEGI' },
];
---
<section id="descubre" class="intro section" data-ground="light" aria-labelledby="intro-title">
  <div class="wrap intro__grid">
    <div class="intro__media" data-reveal>
      <Photo id="wc-42373253" ratio="4/3" sizes="(max-width: 900px) 100vw, 56vw" focal="50% 55%" />
      <p class="tiny muted intro__cap">Semidesierto potosino, camino a Matehuala.</p>
    </div>
    <div class="intro__text" data-reveal>
      <h2 id="intro-title" class="display display--lg">Un estado.<br /><em>Muchas formas de sentirlo.</em></h2>
      <p class="lede">Real de Catorce está en lo alto de la sierra; Ciudad Valles, casi al nivel del río. Entre ambos, San Luis Potosí pasa del desierto a la cantera, de los manantiales a la selva.</p>
      <p class="body muted">Cuatro regiones con paisajes, climas y culturas distintas, que se pueden recorrer en un mismo viaje. Este sitio te ayuda a descubrirlas todas, no solo las más conocidas.</p>
    </div>
  </div>
  <dl class="wrap intro__figures" data-reveal>
    {figures.map((f) => (
      <div><dt>{f.label}</dt><dd class="display">{f.value}</dd></div>
    ))}
  </dl>
  <p class="wrap source intro__src">
    Regiones y municipios: <a href={sourceUrl('pdu-slp') ?? '#'}>PDU-SLP</a>. Pueblos Mágicos: SECTUR. Altitudes: {profile.sourceShort}, {profile.caveat}
  </p>
</section>

<style>
  .intro__grid { display: grid; gap: var(--sc-7); align-items: center; }
  @media (min-width: 900px) { .intro__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(3rem, 6vw, 7rem); } }
  .intro__text { display: grid; gap: var(--sc-5); padding-bottom: var(--sc-4); }
  .intro__text h2 em { color: var(--slp-gold-deep); }
  .intro__text h2 { font-size: clamp(2.8rem, 4.5vw, 5.1rem); line-height: .98; }
  .intro__media { position: relative; }
  @media (min-width: 900px) { .intro__media { padding-top: 4rem; } .intro__media::before { content: 'SAN LUIS POTOSÍ'; position: absolute; top: .2rem; left: 0; font: 650 .7rem/1 var(--sc-font-text); letter-spacing: .3em; color: var(--sc-ink-soft); } }
  .intro__cap { margin-top: 0.6rem; }
  .intro__figures {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0;
    margin-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--sc-hairline-strong);
  }
  @media (min-width: 900px) { .intro__figures { grid-template-columns: repeat(4, 1fr); } }
  .intro__figures div { padding: var(--sc-5) var(--sc-4) var(--sc-4) 0; display: flex; flex-direction: column-reverse; gap: 0.35rem; border-bottom: 1px solid var(--sc-hairline); }
  .intro__figures dt { font-size: var(--sc-t-sm); color: var(--sc-ink-soft); max-width: 22ch; }
  .intro__figures dd { margin: 0; font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1; font-variant-numeric: lining-nums; }
  .intro__src { margin-top: var(--sc-4); }
</style>
