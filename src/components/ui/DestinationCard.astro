---
/**
 * Editorial destination item: image first, then a museum-label caption
 * (region · kind, name, optional one-line description). Not a boxed card.
 */
import Photo from '@/components/media/Photo.astro';
import RouteButton from './RouteButton.astro';
import { destHref } from '@/i18n/routes';
import { REGION_NAME, regionMeta } from '@/data/regions';
import type { Destination } from '@/data/research';

interface Props {
  d: Destination;
  ratio?: string;
  sizes?: string;
  showText?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
  size?: 'lg' | 'md' | 'sm';
  class?: string;
  imageId?: string | null;
}
const { d, ratio = '4/5', sizes = '(max-width: 760px) 92vw, 33vw', showText = false, headingLevel = 'h3', size = 'md', class: cls, imageId } = Astro.props;
const H = headingLevel;
const img = imageId ?? d.media.card;
---
<article class:list={['dcard', `dcard--${size}`, cls]} data-region={d.region}>
  <a class="dcard__media" href={destHref(d.slug)} tabindex="-1" aria-hidden="true">
    <Photo
      id={img}
      ratio={ratio}
      sizes={sizes}
      fallback={{ label: `${d.name} · Imagen`, subject: 'Fotografía del destino pendiente.', region: d.region, ratio: ratio.replace('/', ':') }}
    />
  </a>
  <div class="dcard__route"><RouteButton id={d.id} name={d.name} variant="icon" /></div>
  <div class="dcard__body">
    <p class="dcard__meta"><span class="dcard__region">{REGION_NAME[d.region]}</span><span aria-hidden="true"> · </span>{d.kind}</p>
    <H class="dcard__name display"><a href={destHref(d.slug)}>{d.name}</a></H>
    {showText && <p class="dcard__text">{d.description}</p>}
  </div>
</article>

<style>
  .dcard { position: relative; display: grid; gap: 0.9rem; align-content: start; }
  .dcard__media { position: relative; display: block; overflow: hidden; border-radius: var(--sc-r-sm); }
  /* region indicator: a thin rule in the region's colour along the photo's foot */
  .dcard__media::after { content: ''; position: absolute; left: 0; bottom: 0; width: 2.6rem; height: 3px; background: var(--slp-region-ui); transition: width 420ms var(--sc-ease-out); }
  .dcard__media :global(img) { transition: transform 900ms var(--sc-ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .dcard:hover .dcard__media :global(img) { transform: scale(1.035); }
    .dcard:hover .dcard__media::after { width: 100%; }
    .dcard__name a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  }
  .dcard__route { position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2; }
  .dcard__body { display: grid; gap: 0.35rem; }
  .dcard__meta { font: 700 0.7rem/1.3 var(--sc-font-text); letter-spacing: 0.14em; text-transform: uppercase; color: var(--sc-ink-soft); }
  .dcard__region { color: var(--slp-region-text); }
  .dcard__name { font-size: 1.75rem; line-height: 1.05; }
  .dcard--lg .dcard__name { font-size: clamp(2rem, 1.5rem + 1.6vw, 2.9rem); }
  .dcard--sm .dcard__name { font-size: 1.4rem; }
  .dcard__name a { text-decoration: none; color: inherit; }
  .dcard__name a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .dcard__text { font-size: var(--sc-t-sm); color: var(--sc-ink-soft); max-width: 46ch; line-height: 1.55; }
</style>
