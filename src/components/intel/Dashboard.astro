---
/**
 * Tourism intelligence dashboard. Three layers, never mixed:
 *   observed (counts from official sources) · derived (indices computed by this
 *   project) · simulated (synthetic profiles run through the engines).
 * Every chart answers one question. Bars use a single ink: the four regional
 * accents do not pass a colour-blind separation check as a categorical
 * palette, so a region is always named in text and given its own row or panel,
 * with the accent only as a small swatch beside the label. Values are printed
 * next to every bar, so each chart is also its own table.
 */
import { intelPlaces, intelMunicipalities, intelEvents, intelClimate, intelDataset } from '@/data/intel';
import { lodging, food } from '@/data/portal';
import { concentration, topShare } from '@/lib/intel/features';
import { runScenario, SCENARIO_LABEL, SCENARIO_ORIGINS, SCENARIO_MONTHS } from '@/lib/intel/scenario';
import { LOW_EXPOSURE } from '@/lib/intel/scoring';
import { KIND_LABEL, REGION_LABEL, MONTHS_ES } from '@/lib/intel/taxonomy';
import type { IntelKind, RegionId } from '@/lib/intel/types';
import { muniHref, href } from '@/i18n/routes';

const regions = Object.keys(REGION_LABEL) as RegionId[];
const pct = (v: number) => `${Math.round(v * 100)} %`;
const n = (v: number) => v.toLocaleString('es-MX');
const w = (v: number, max: number) => `width:${max > 0 ? Math.max(v > 0 ? 1.5 : 0, (v / max) * 100) : 0}%`;

// ---- observed ---------------------------------------------------------------------------
const munis = intelMunicipalities;
const withAssets = munis.filter((m) => m.assets > 0);
const kinds = (Object.keys(KIND_LABEL) as IntelKind[]).filter((k) => intelPlaces.some((p) => p.kind === k));
const kindRows = kinds.map((k) => ({ k, label: KIND_LABEL[k], by: regions.map((r) => intelPlaces.filter((p) => p.kind === k && p.region === r).length), total: intelPlaces.filter((p) => p.kind === k).length })).sort((a, b) => b.total - a.total);
const kindMax = Math.max(...kindRows.flatMap((r) => r.by));
const topAssets = [...munis].sort((a, b) => b.assets - a.assets).slice(0, 12);
const infra = regions.map((r) => ({ r, lodging: lodging.filter((l) => l.region === r).length, food: food.filter((f) => f.region === r).length, munis: munis.filter((m) => m.region === r).length }));
const infraMax = Math.max(...infra.map((i) => i.lodging));
const foodMax = Math.max(...infra.map((i) => i.food));
const dated = intelEvents.filter((e) => e.date_confidence !== 'unknown');
const evGrid = regions.map((r) => ({ r, months: MONTHS_ES.map((_, i) => dated.filter((e) => e.region === r && e.months.includes(i + 1)).length) }));
const evMax = Math.max(...evGrid.flatMap((g) => g.months));
const evTotals = MONTHS_ES.map((_, i) => dated.filter((e) => e.months.includes(i + 1)).length);
const thin = evTotals.map((v, i) => ({ v, i })).sort((a, b) => a.v - b.v).slice(0, 2);
const rain = regions.map((r) => ({ r, months: intelClimate[r].map((m) => Math.round(m.rain_days)) }));
const rainMax = Math.max(...rain.flatMap((g) => g.months));

// ---- derived -----------------------------------------------------------------------------
const assetVals = munis.map((m) => m.assets), lodgingVals = munis.map((m) => m.counts.lodging);
const potential = [...munis].filter((m) => m.assets > 0).sort((a, b) => b.diversification_potential - a.diversification_potential).slice(0, 12);
const exposed = [...munis].sort((a, b) => b.exposure_proxy - a.exposure_proxy).slice(0, 6);
const lowWithAssets = withAssets.filter((m) => m.exposure_proxy < LOW_EXPOSURE);
const eventOnly = munis.filter((m) => m.assets === 0 && m.counts.events > 0);

// ---- simulated ---------------------------------------------------------------------------
const scenario = runScenario(await intelDataset());
const [sRel, sBonus, sAlt] = scenario.steps;
const delta = Math.round((sAlt.lowExposureShare - sRel.lowExposureShare) * 100);
---
<section id="observado" class="psec" data-ground="ivory" aria-labelledby="db-o">
  <div class="wrap">
    <div class="psec__head">
      <p><span class="dclass" data-class="observado">Datos observados</span></p>
      <h2 id="db-o" class="psec__title">Lo que registran las fuentes oficiales</h2>
      <p class="body">Conteos directos de la base del portal: Secretaría de Turismo, Secretaría de Cultura (SIC), INAH e INEGI (Censo 2020 y DENUE). Son registros, no visitantes: dicen qué hay y dónde, no cuánta gente va.</p>
    </div>

    <ul class="db-stats">
      <li><b>{munis.length}</b><span>municipios</span></li>
      <li><b>{withAssets.length}</b><span>con al menos un atractivo puntuable</span></li>
      <li><b>{munis.length - withAssets.length}</b><span>sin ninguno en la base</span></li>
      <li><b>{n(intelPlaces.length)}</b><span>lugares que el portal puede recomendar</span></li>
      <li><b>{n(dated.length)}</b><span>fiestas y eventos con mes conocido</span></li>
    </ul>

    <div class="db-grid">
      <figure class="db-fig db-fig--wide">
        <figcaption><h3 class="db-q">¿Cómo se reparten los atractivos por región y por tipo?</h3><p class="db-note">Lugares recomendables de la base. Cada celda muestra el número y una barra a la misma escala.</p></figcaption>
        <div class="db-scroll" role="region" aria-label="Atractivos por tipo y región" tabindex="0">
          <table class="db-matrix">
            <thead><tr><th scope="col">Tipo</th>{regions.map((r) => <th scope="col" data-region={r}><span class="db-sw" aria-hidden="true"></span>{REGION_LABEL[r]}</th>)}<th scope="col">Total</th></tr></thead>
            <tbody>
              {kindRows.map((row) => (
                <tr><th scope="row">{row.label}</th>{row.by.map((v) => <td><span class="db-cell"><span class="db-cell__bar" style={w(v, kindMax)}></span></span><span class="db-cell__v">{v}</span></td>)}<td class="db-total">{row.total}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>

      <figure class="db-fig">
        <figcaption><h3 class="db-q">¿Qué municipios tienen mayor cobertura?</h3><p class="db-note">Atractivos puntuables (destinos, museos, arqueología, áreas protegidas). Los 12 primeros de {munis.length}.</p></figcaption>
        <ul class="db-bars">
          {topAssets.map((m) => <li class="ibar" title={`${m.name}: ${m.assets} atractivos`}><span>{m.slug ? <a href={muniHref(m.slug)}>{m.name}</a> : m.name}</span><span class="ibar__track"><span class="ibar__fill" style={w(m.assets, topAssets[0].assets)}></span></span><span class="ibar__v">{m.assets}</span></li>)}
        </ul>
        <p class="db-note">{munis.length - withAssets.length} municipios no tienen ningún atractivo puntuable en la base; {eventOnly.length} de ellos sí registran fiestas o eventos.</p>
      </figure>

      <figure class="db-fig">
        <figcaption><h3 class="db-q">¿Dónde está la infraestructura registrada?</h3><p class="db-note">Establecimientos de hospedaje y de alimentos (DENUE y directorio Estadía). No confirma operación actual ni capacidad.</p></figcaption>
        <div class="db-scroll" role="region" aria-label="Tabla de datos" tabindex="0"><table class="db-two">
          <thead><tr><th scope="col">Región</th><th scope="col">Hospedaje</th><th scope="col">Alimentos (visibles en el portal)</th></tr></thead>
          <tbody>
            {infra.map((i) => (
              <tr data-region={i.r}>
                <th scope="row"><span class="db-sw" aria-hidden="true"></span>{REGION_LABEL[i.r]}<span class="db-sub">{i.munis} municipios</span></th>
                <td><span class="db-cell"><span class="db-cell__bar" style={w(i.lodging, infraMax)}></span></span><span class="db-cell__v">{n(i.lodging)}</span></td>
                <td><span class="db-cell"><span class="db-cell__bar" style={w(i.food, foodMax)}></span></span><span class="db-cell__v">{n(i.food)}</span></td>
              </tr>
            ))}
          </tbody>
        </table></div>
      </figure>

      <figure class="db-fig db-fig--wide">
        <figcaption><h3 class="db-q">¿Cómo cambia la oferta de fiestas y eventos a lo largo del año?</h3><p class="db-note">Eventos con mes conocido, por región. Un evento que abarca dos meses cuenta en ambos. Los meses con menos registros son {MONTHS_ES[thin[0].i]} ({thin[0].v}) y {MONTHS_ES[thin[1].i]} ({thin[1].v}).</p></figcaption>
        <div class="db-scroll" role="region" aria-label="Eventos por mes y región" tabindex="0">
          <table class="db-months">
            <thead><tr><th scope="col">Región</th>{MONTHS_ES.map((m) => <th scope="col"><abbr title={m}>{m.slice(0, 3)}</abbr></th>)}</tr></thead>
            <tbody>
              {evGrid.map((g) => (
                <tr data-region={g.r}><th scope="row"><span class="db-sw" aria-hidden="true"></span>{REGION_LABEL[g.r]}</th>{g.months.map((v, i) => <td title={`${REGION_LABEL[g.r]}, ${MONTHS_ES[i]}: ${v} eventos`}><span class="db-col"><span class="db-col__bar" style={`height:${evMax ? (v / evMax) * 100 : 0}%`}></span></span><span class="db-col__v">{v}</span></td>)}</tr>
              ))}
              <tr class="db-months__total"><th scope="row">Estado</th>{evTotals.map((v) => <td><span class="db-col__v">{v}</span></td>)}</tr>
            </tbody>
          </table>
        </div>
      </figure>

      <figure class="db-fig db-fig--wide">
        <figcaption><h3 class="db-q">¿Cuándo llueve en cada región?</h3><p class="db-note">Días con lluvia al mes, promedio modelado 2016–2025 (reanálisis de Open-Meteo, CC BY 4.0). No es una normal climatológica oficial ni un pronóstico; es el contexto que acompaña a las temporadas.</p></figcaption>
        <div class="db-scroll" role="region" aria-label="Días con lluvia por mes y región" tabindex="0">
          <table class="db-months">
            <thead><tr><th scope="col">Región</th>{MONTHS_ES.map((m) => <th scope="col"><abbr title={m}>{m.slice(0, 3)}</abbr></th>)}</tr></thead>
            <tbody>
              {rain.map((g) => (
                <tr data-region={g.r}><th scope="row"><span class="db-sw" aria-hidden="true"></span>{REGION_LABEL[g.r]}</th>{g.months.map((v, i) => <td title={`${REGION_LABEL[g.r]}, ${MONTHS_ES[i]}: ${v} días con lluvia`}><span class="db-col"><span class="db-col__bar" style={`height:${(v / rainMax) * 100}%`}></span></span><span class="db-col__v">{v}</span></td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>
    </div>
  </div>
</section>

<section id="derivado" class="psec" data-ground="light" aria-labelledby="db-d">
  <div class="wrap">
    <div class="psec__head">
      <p><span class="dclass" data-class="derivado">Indicadores derivados</span></p>
      <h2 id="db-d" class="psec__title">Lo que el proyecto calcula con esos registros</h2>
      <p class="body">Índices construidos por este proyecto, de 0 a 1, con fórmula y límites publicados. La <strong>exposición</strong> es un proxy (hospedaje registrado, destinos emblemáticos y Pueblos Mágicos): no mide visitantes, ocupación ni saturación.</p>
    </div>

    <ul class="db-stats">
      <li><b>{pct(topShare(assetVals, 5))}</b><span>de los atractivos puntuables está en 5 municipios</span></li>
      <li><b>{pct(topShare(lodgingVals, 5))}</b><span>del hospedaje registrado está en 5 municipios</span></li>
      <li><b>{concentration(lodgingVals).toLocaleString('es-MX')}</b><span>concentración del hospedaje (Herfindahl–Hirschman, 0 a 1)</span></li>
      <li><b>{lowWithAssets.length}</b><span>municipios con atractivos y exposición estimada baja (menor a {LOW_EXPOSURE.toLocaleString('es-MX')})</span></li>
    </ul>

    <div class="db-grid">
      <figure class="db-fig db-fig--wide">
        <figcaption><h3 class="db-q">¿Dónde hay oportunidades de diversificación?</h3><p class="db-note">Municipios con qué ofrecer, dónde atender al visitante y poca exposición estimada. Potencial = (1 − exposición) × (0.6 · atractivo + 0.4 · infraestructura).</p></figcaption>
        <div class="db-scroll" role="region" aria-label="Municipios con mayor potencial de diversificación" tabindex="0">
          <table class="db-pot">
            <thead><tr><th scope="col">Municipio</th><th scope="col">Atractivos</th><th scope="col">Eventos</th><th scope="col">Infraestructura</th><th scope="col">Exposición (proxy)</th><th scope="col">Potencial de diversificación</th></tr></thead>
            <tbody>
              {potential.map((m) => (
                <tr data-region={m.region ?? undefined}>
                  <th scope="row"><span class="db-sw" aria-hidden="true"></span>{m.slug ? <a href={muniHref(m.slug)}>{m.name}</a> : m.name}<span class="db-sub">{m.region ? REGION_LABEL[m.region] : 'Región por confirmar'}</span></th>
                  <td class="db-num">{m.assets}</td><td class="db-num">{m.counts.events}</td>
                  {[m.infrastructure_index, m.exposure_proxy, m.diversification_potential].map((v) => <td><span class="db-cell"><span class="db-cell__bar" style={w(v, 1)}></span></span><span class="db-cell__v">{v.toFixed(2)}</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>

      <figure class="db-fig">
        <figcaption><h3 class="db-q">¿Qué municipios concentran la exposición?</h3><p class="db-note">Proxy de exposición, de 0 a 1. Los seis valores más altos.</p></figcaption>
        <ul class="db-bars">
          {exposed.map((m) => <li class="ibar" title={`${m.name}: exposición estimada ${m.exposure_proxy.toFixed(2)}`}><span>{m.name}</span><span class="ibar__track"><span class="ibar__fill" style={w(m.exposure_proxy, 1)}></span></span><span class="ibar__v">{m.exposure_proxy.toFixed(2)}</span></li>)}
        </ul>
        <p class="db-note">Un valor alto no penaliza a ningún lugar en el recomendador: solo decide desde dónde se proponen alternativas.</p>
      </figure>

      <figure class="db-fig">
        <figcaption><h3 class="db-q">¿Qué eventos pueden ayudar a repartir visitantes?</h3><p class="db-note">Municipios sin atractivo puntuable en la base que sí registran fiestas o eventos con mes conocido.</p></figcaption>
        <p class="db-big"><b>{eventOnly.length}</b> municipios</p>
        <p class="db-note">{eventOnly.slice(0, 10).map((m) => m.name).join(', ')}{eventOnly.length > 10 ? ` y ${eventOnly.length - 10} más` : ''}. Su calendario está en <a href={href('events')}>Festividades y eventos</a>, con el estado de cada fecha.</p>
      </figure>
    </div>
  </div>
</section>

<section id="simulado" class="psec" data-ground="ivory" aria-labelledby="db-s">
  <div class="wrap">
    <div class="psec__head">
      <p><span class="dclass" data-class="simulado">Escenario simulado</span></p>
      <h2 id="db-s" class="psec__title">¿Hacia dónde apuntan las sugerencias?</h2>
      <p class="body"><strong>{SCENARIO_LABEL}.</strong> Se ejecutó el recomendador para {scenario.runs} perfiles sintéticos (los 8 segmentos × {SCENARIO_ORIGINS.length} ciudades de salida × {SCENARIO_MONTHS.length} meses), sin ningún visitante. Mide <em>sugerencias</em>, no viajes ni visitas: muestra cómo cambia el destino de las recomendaciones al activar cada motor.</p>
    </div>
    <div class="db-grid">
      <figure class="db-fig db-fig--wide">
        <figcaption><h3 class="db-q">Proporción de sugerencias en municipios con exposición estimada baja</h3><p class="db-note">Salidas desde {SCENARIO_ORIGINS.join(', ')}; meses: {SCENARIO_MONTHS.map((m) => MONTHS_ES[m - 1]).join(', ')}.</p></figcaption>
        <ul class="db-bars db-bars--scenario">
          {scenario.steps.map((s) => <li class="ibar" title={`${s.label}: ${pct(s.lowExposureShare)} de ${s.suggestions} sugerencias`}><span>{s.label}</span><span class="ibar__track"><span class="ibar__fill" style={w(s.lowExposureShare, 1)}></span></span><span class="ibar__v">{pct(s.lowExposureShare)}</span></li>)}
        </ul>
        <div class="db-scroll" role="region" aria-label="Tabla de datos" tabindex="0"><table class="db-two">
          <thead><tr><th scope="col">Configuración</th><th scope="col">Sugerencias</th><th scope="col">Municipios distintos</th><th scope="col">En los 5 más sugeridos</th><th scope="col">Relevancia media de la lista</th></tr></thead>
          <tbody>{scenario.steps.map((s) => <tr><th scope="row">{s.label}</th><td class="db-num">{n(s.suggestions)}</td><td class="db-num">{s.municipalities}</td><td class="db-num">{pct(s.top5Share)}</td><td class="db-num">{s.meanRelevance.toLocaleString('es-MX')} / 100</td></tr>)}</tbody>
        </table></div>
      </figure>
      <div class="db-fig db-fig--wide db-read">
        <h3 class="db-q">Cómo leerlo</h3>
        <ul class="body">
          <li>Los bonos por sí solos casi no mueven la lista ({pct(sRel.lowExposureShare)} frente a {pct(sBonus.lowExposureShare)}): son pequeños a propósito, para no sacrificar relevancia ({sRel.meanRelevance.toLocaleString('es-MX')} y {sBonus.meanRelevance.toLocaleString('es-MX')} puntos de relevancia media).</li>
          <li>Las alternativas de redistribución sí cambian el reparto: {delta > 0 ? `${delta} puntos porcentuales más` : 'sin cambio apreciable'} de sugerencias en municipios poco expuestos, mostradas aparte y sin quitar nada de la lista principal.</li>
          <li>No es una predicción de comportamiento. Para saber si un visitante acepta esas alternativas hacen falta datos observados, que hoy no existen.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .db-stats { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: var(--sc-4) var(--sc-5); padding: var(--sc-5) 0; margin-bottom: var(--sc-6); border-block: 1px solid var(--sc-hairline-strong); }
  .db-stats li { display: grid; gap: 0.3rem; align-content: start; }
  .db-stats b { font: 500 clamp(2.4rem, 2rem + 1.6vw, 3.4rem)/1 var(--sc-font-display); font-variant-numeric: tabular-nums; }
  .db-stats span { font-size: 0.82rem; line-height: 1.4; color: var(--sc-ink-soft); max-width: 22ch; }
  .db-grid { display: grid; gap: var(--sc-7) var(--sc-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 960px) { .db-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .db-fig--wide { grid-column: 1 / -1; } }
  .db-fig { display: grid; gap: var(--sc-4); align-content: start; margin: 0; min-width: 0; }
  .db-q { font: 600 clamp(1.4rem, 1.2rem + 0.7vw, 1.75rem)/1.12 var(--sc-font-display); text-wrap: balance; }
  .db-note { font-size: 0.8rem; line-height: 1.5; color: var(--sc-ink-soft); max-width: 78ch; }
  .db-note a, .db-bars a, .db-pot a { color: inherit; }
  figcaption { display: grid; gap: 0.4rem; }
  .db-bars { list-style: none; display: grid; gap: 0.5rem; }
  .db-bars .ibar__fill, .db-cell__bar, .db-col__bar { background: var(--slp-charcoal); }
  @media (min-width: 700px) { .db-bars--scenario .ibar { grid-template-columns: minmax(9rem, 20rem) minmax(0, 1fr) auto; } }
  .db-two { min-width: 30rem; }
  .db-big { font-size: 0.95rem; }
  .db-big b { font: 500 3rem/1 var(--sc-font-display); margin-right: 0.3rem; }
  .db-read ul { display: grid; gap: 0.6rem; padding-left: 1.1rem; }

  .db-scroll { overflow-x: auto; }
  .db-scroll:focus-visible { outline: 2px solid var(--slp-charcoal); outline-offset: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.84rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 0.5rem 0.6rem 0.5rem 0; border-bottom: 1px solid var(--sc-hairline); vertical-align: middle; font-weight: 500; }
  thead th { font: 700 0.62rem/1.25 var(--sc-font-text); letter-spacing: 0.1em; text-transform: uppercase; color: var(--sc-ink-soft); vertical-align: bottom; }
  tbody th { font-weight: 650; }
  .db-sw { display: inline-block; width: 8px; height: 8px; margin-right: 0.45rem; border-radius: 50%; background: var(--slp-region-ui, var(--sc-ink-soft)); }
  .db-sub { display: block; font-size: 0.7rem; font-weight: 500; color: var(--sc-ink-soft); }
  .db-num, .db-total { font-weight: 700; }
  .db-cell { display: inline-block; width: min(5.5rem, 46%); height: 8px; margin-right: 0.5rem; background: var(--sc-surface); border-radius: 2px; overflow: hidden; vertical-align: middle; }
  [data-ground='ivory'] .db-cell, [data-ground='ivory'] .db-col { background: var(--slp-ivory-3); }
  .db-cell__bar { display: block; height: 100%; border-radius: 0 2px 2px 0; }
  .db-cell__v { font-weight: 650; }
  .db-matrix { min-width: 38rem; }
  .db-pot { min-width: 46rem; }
  .db-months { min-width: 44rem; table-layout: fixed; }
  .db-months th:first-child { width: 7.5rem; }
  .db-months td, .db-months thead th:not(:first-child) { text-align: center; padding-inline: 0.15rem; }
  .db-col { display: flex; align-items: flex-end; justify-content: center; height: 3rem; margin: 0 auto 0.25rem; width: 62%; background: var(--sc-surface); border-radius: 2px; overflow: hidden; }
  .db-col__bar { display: block; width: 100%; border-radius: 2px 2px 0 0; }
  .db-col__v { font-size: 0.74rem; font-weight: 650; }
  .db-months__total th, .db-months__total td { border-bottom: 0; color: var(--sc-ink-soft); }
  .db-months abbr { text-decoration: none; }
</style>
