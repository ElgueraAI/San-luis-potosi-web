{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "public/vendor",
    "research/raw",
    "research/scripts",
    "media-source",
    "scrollcraft/lab"
  ],
  "compilerOptions": {
