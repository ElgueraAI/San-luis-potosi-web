{
  "name": "san-luis-potosi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cuatro mundos. Un San Luis Potosí. Academic MVP of a cinematic tourism website.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/vendor-maplibre.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "facts:report": "node scripts/facts/report.mjs",
    "geo:profile": "node scripts/geo/build-profile.mjs",
    "media:build": "node scripts/media/build-media.mjs",
    "verify:pages": "node scripts/verify/pages.mjs",
    "test:geo": "node scripts/test-geo.mjs",
    "test:intel": "node scripts/test-geo.mjs tests/intel",
    "test:signals": "node scripts/test-geo.mjs tests/signals",
    "test:data": "node --test tests/data-integrity/*.test.mjs",
    "data:prepare": "node scripts/academic/etl-mission03.mjs",
    "test": "node scripts/test-geo.mjs && node scripts/test-geo.mjs tests/intel && node scripts/test-geo.mjs tests/signals && npm run test:data",
    "intel:report": "node scripts/intel/report.mjs",
    "verify:routing": "node scripts/verify/routing.mjs",
    "verify:navigation": "node scripts/verify/navigation.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^7.3.5",
    "maplibre-gl": "^6.12.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
